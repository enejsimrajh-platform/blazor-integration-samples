@using System.Text.Json
@using MvcConsumer.Areas.BlazorWasm.Models

@model WeatherViewModel

@{
    ViewData["Title"] = "Weather";
    ViewData["Blazor:Autostart"] = "false";
}

@section Scripts {
    <script>
        blazorWasm.start().then(() => {
            const weather = document.createElement("wasm-weather");
            weather.forecasts = @Html.Raw(JsonSerializer.Serialize(Model.Data));
            document.getElementById("weather-container").append(weather);
        });
    </script>
}

<h1>@ViewData["Title"]</h1>
<h2>External data</h2>

<p>This page renders a weather component implemented as Blazor custom element.</p>
<p>Data is loaded on consumer's side using server's public API and passed to custom element via its property (component parameter).</p>
<div id="weather-container" class="component-container"></div>