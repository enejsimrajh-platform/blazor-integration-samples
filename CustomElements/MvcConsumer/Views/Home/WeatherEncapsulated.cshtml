@{
    ViewData["Title"] = "Weather";
}

@section Styles {
    <link rel="stylesheet" href="https://localhost:44345/app.css" />
}

@section Scripts {
    <script src="https://localhost:44345/app.js"></script>
}

<h1>@ViewData["Title"]</h1>
<h2>Encapsulated data</h2>

<p>This page renders a weather component implemented as Blazor custom element.</p>
<p>Custom element fetches data itself using HTTP client.</p>
<div class="component-container">
    <wasm-weather></wasm-weather>
</div>
