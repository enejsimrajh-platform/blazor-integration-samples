@inject IConfiguration Configuration

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var blazorUrl = Configuration["BlazorUrl"]
        ?? throw new InvalidOperationException("Missing 'BlazorUrl' configuration value.");
    var baseUrl = new Uri(blazorUrl);
}

@section Styles {
    <link rel="stylesheet" href="@(new Uri(baseUrl, "app.css"))" />
}

@section Scripts {
    <script src="@(new Uri(baseUrl, "app.js"))" autostart="@ViewData["Blazor:Autostart"]"></script>
    @await RenderSectionAsync("Scripts", required: false)
}

@RenderBody()